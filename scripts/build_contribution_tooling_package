#!/usr/bin/env python3
"""Build the sfg-contribution-tooling Debian package from the tools pinned in its tools file."""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import shutil
import subprocess
import sys
import tempfile
import tomllib
import urllib.request
import zipfile
from dataclasses import dataclass
from pathlib import Path

package_name = "sfg-contribution-tooling"
repository_root = Path(__file__).resolve().parent.parent
package_source = repository_root / "src" / package_name
config_directory = repository_root / "contributing" / "config"
tools_file = repository_root / "src" / f"{package_name}-tools.toml"
install_prefix = Path("opt") / package_name
doc_directory = Path("usr") / "share" / "doc" / package_name


@dataclass
class Pin:
    name: str
    version: str
    binary: str
    source_build: bool = False

    @property
    def requirement(self) -> str:
        return f"{self.name}=={self.version}"


@dataclass
class DprintPlugin:
    name: str
    version: str
    url: str
    sha256: str


def read_pins() -> tuple[list[Pin], list[DprintPlugin]]:
    """Read the pins of the packaged tools and dprint plugins, in the order of the tools file."""
    with tools_file.open("rb") as file:
        tools = tomllib.load(file)

    plugins = tools.pop("dprint-plugins")

    return (
        [Pin(name, **tool) for name, tool in tools.items()],
        [DprintPlugin(name, **plugin) for name, plugin in plugins.items()],
    )


def build_wheels(pins: list[Pin], wheel_directory: Path) -> None:
    """Fetch the wheels for the current architecture, building only allowed source distributions."""
    binary_only = [pin.name for pin in pins if not pin.source_build]

    subprocess.run(
        [
            sys.executable,
            "-m",
            "pip",
            "wheel",
            "--no-deps",
            "--only-binary",
            ",".join(binary_only),
            "--wheel-dir",
            str(wheel_directory),
            *[pin.requirement for pin in pins],
        ],
        check=True,
    )


def extract_wheel(pin: Pin, wheel_directory: Path, staging_directory: Path) -> None:
    """Install the binary and the license files of one wheel into the staging directory."""
    normalized_name = pin.name.replace("-", "_")
    (wheel,) = wheel_directory.glob(f"{normalized_name}-{pin.version}-*.whl")

    with zipfile.ZipFile(wheel) as archive:
        names = archive.namelist()
        (binary,) = fnmatch.filter(names, pin.binary)
        target = staging_directory / install_prefix / "bin" / Path(binary).name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(archive.read(binary))
        target.chmod(0o755)

        for license_file in fnmatch.filter(names, "*.dist-info/licenses/?*"):
            target = (
                staging_directory / doc_directory / pin.name / Path(license_file).name
            )
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(archive.read(license_file))


def download_plugin(plugin: DprintPlugin, staging_directory: Path) -> None:
    """Install one dprint plugin into the staging directory after verifying its checksum."""
    url = plugin.url.format(version=plugin.version)

    # The plugin server rejects the default User-Agent of urllib.
    request = urllib.request.Request(url, headers={"User-Agent": package_name})

    with urllib.request.urlopen(request) as response:
        content = response.read()

    checksum = hashlib.sha256(content).hexdigest()

    if checksum != plugin.sha256:
        sys.exit(
            f"Error: The checksum of {url} is {checksum}, but {plugin.sha256} is pinned."
        )

    target = (
        staging_directory / install_prefix / "share" / "dprint" / f"{plugin.name}.wasm"
    )
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(content)


def write_control(
    pins: list[Pin],
    plugins: list[DprintPlugin],
    architecture: str,
    staging_directory: Path,
) -> None:
    """Add the architecture and the tool versions to the static control file."""
    control_file = staging_directory / "DEBIAN" / "control"
    lines = control_file.read_text().splitlines()
    tools = ", ".join(f"{pin.name} {pin.version}" for pin in pins)
    dprint_plugins = ", ".join(f"{plugin.name} {plugin.version}" for plugin in plugins)
    # "Package" stays the first field, the extended description follows the synopsis.
    lines.insert(1, f"Architecture: {architecture}")
    lines.append(f" Installs {tools} to /{install_prefix}/bin")
    lines.append(
        f" and the dprint plugins {dprint_plugins} to /{install_prefix}/share/dprint."
    )
    control_file.write_text("\n".join(lines) + "\n")


def normalize_permissions(staging_directory: Path) -> None:
    """Make the package independent of the umask of the build machine."""
    for path in [staging_directory, *staging_directory.rglob("*")]:
        if path.is_dir() or path.parent.name == "bin":
            path.chmod(0o755)
        else:
            path.chmod(0o644)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--output-directory",
        type=Path,
        default=Path(),
        help="directory to write the package to",
    )
    args = parser.parse_args()

    pins, plugins = read_pins()
    architecture = subprocess.run(
        ["dpkg", "--print-architecture"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()

    with tempfile.TemporaryDirectory() as temporary_directory:
        wheel_directory = Path(temporary_directory) / "wheels"
        staging_directory = Path(temporary_directory) / package_name

        build_wheels(pins, wheel_directory)
        shutil.copytree(package_source, staging_directory)

        for pin in pins:
            extract_wheel(pin, wheel_directory, staging_directory)

        for plugin in plugins:
            download_plugin(plugin, staging_directory)

        shutil.copytree(
            config_directory, staging_directory / install_prefix / "share" / "config"
        )
        write_control(pins, plugins, architecture, staging_directory)
        normalize_permissions(staging_directory)

        args.output_directory.mkdir(parents=True, exist_ok=True)
        # Given a directory, dpkg-deb names the package <package>_<version>_<architecture>.deb.
        # Set the compression explicitly, as the default differs between dpkg versions.
        subprocess.run(
            [
                "dpkg-deb",
                "--build",
                "--root-owner-group",
                "-Zxz",
                "-z9",
                str(staging_directory),
                str(args.output_directory),
            ],
            check=True,
        )


if __name__ == "__main__":
    main()
